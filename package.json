{
  "name": "@lon-ask/dockit",
  "version": "0.1.7",
  "license": "MIT",
  "description": "Local documentation hub — normalize multiple doc sources into a unified searchable bundle",
  "type": "module",
  "repository": {
    "url": "https://github.com/karthik20/dockit"
  },
  "bin": {
    "dockit": "./bin/dockit.js"
  },
  "files": [
    "bin/",
    "apps/server/src/",
    "apps/server/dist/",
    "apps/server/package.json",
    "apps/client/src/",
    "apps/client/dist/",
    "apps/client/package.json",
    "apps/client/vite.config.ts",
    "apps/client/index.html",
    "dockit.yaml",
    "SKILL.md",
    "scripts/mcp-wrapper.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "apps/server",
    "apps/client",
    "packages/embeddings"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:client": "npm run dev -w apps/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:embeddings": "npm run build -w packages/embeddings",
    "build:server": "npm run build:embeddings && npm run build -w apps/server",
    "build:client": "npm run build -w apps/client",
    "build": "npm run build:server && npm run build:client",
    "desktop:dev": "npm run build:server && npm run tauri -w apps/client -- dev",
    "desktop:build": "npm run build:server && npm run tauri -w apps/client -- build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "better-sqlite3": "^12.9.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.19.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "@asciidoctor/core": "^2.2.9",
    "@antora/cli": "^3.1.14",
    "@antora/site-generator": "^3.2.0-alpha.11",
    "node-html-parser": "^6.1.13",
    "marked": "^18.0.3",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "lucide-react": "^0.469.0",
    "vite": "^6.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@lon-ask/dockit-embeddings": "^0.1.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}